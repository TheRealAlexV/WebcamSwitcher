<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WebcamSwitcher</AssemblyName>
    <RootNamespace>WebcamSwitcher.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WebcamSwitcher.Core\WebcamSwitcher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Harness only (tools/VcamTest): lets it drive the per-slot contract with a
         fake native layer. No runtime effect on the shipped app. -->
    <InternalsVisibleTo Include="WebcamSwitcher.VcamTest" />
  </ItemGroup>
</Project>
