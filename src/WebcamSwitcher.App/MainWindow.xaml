<Window x:Class="WebcamSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebcamSwitcher" Width="760" Height="360"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="BorderA" Grid.Column="0" Margin="4" CornerRadius="6"
                    BorderThickness="2" BorderBrush="#3A3A3A" Background="#111">
                <Grid>
                    <Image x:Name="PreviewA" Stretch="Uniform"/>
                    <TextBlock x:Name="LabelA" Text="Camera 1" Foreground="White" Background="#AA000000"
                               Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border x:Name="BorderB" Grid.Column="1" Margin="4" CornerRadius="6"
                    BorderThickness="2" BorderBrush="#3A3A3A" Background="#111">
                <Grid>
                    <Image x:Name="PreviewB" Stretch="Uniform"/>
                    <TextBlock x:Name="LabelB" Text="Camera 2" Foreground="White" Background="#AA000000"
                               Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Settings" Padding="14,6" Click="Settings_Click" Background="#333" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
