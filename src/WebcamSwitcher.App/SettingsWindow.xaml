<Window x:Class="WebcamSwitcher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebcamSwitcher Settings" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Cameras" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CamAText" Text="—" Foreground="#CCC" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Hotkey" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="HotkeyA" Width="130" Background="#2A2A2A" Foreground="White" BorderBrush="#444"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CamBText" Text="—" Foreground="#CCC" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Hotkey" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="HotkeyB" Width="130" Background="#2A2A2A" Foreground="White" BorderBrush="#444"/>
            </StackPanel>
        </Grid>

        <Separator Margin="0,8"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Rotate through cameras" Foreground="#CCC" VerticalAlignment="Center"/>
            <TextBox x:Name="HotkeyRotate" Width="130" Grid.Column="1" Background="#2A2A2A" Foreground="White" BorderBrush="#444"/>
        </Grid>

        <TextBlock x:Name="NoteText" Text="Changes apply after restart." Foreground="#888" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" Background="#333" Foreground="White" Click="Cancel_Click"/>
            <Button Content="Save" Padding="14,6" Background="#2D7DD2" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
