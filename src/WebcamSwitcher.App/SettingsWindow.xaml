<Window x:Class="WebcamSwitcher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebcamSwitcher Settings" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
        <StackPanel Margin="16">

            <TextBlock Text="Cameras" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel x:Name="CamerasPanel"/>
            <Button x:Name="AddCameraBtn" Content="+ Add camera" HorizontalAlignment="Left" Padding="10,4"
                    Background="#333" Foreground="White" BorderBrush="#444" Click="AddCamera_Click" Margin="0,0,0,16"
                    AutomationProperties.AutomationId="AddCameraButton"/>

            <TextBlock Text="Output" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Width" Foreground="#CCC"/>
                    <ComboBox x:Name="WidthCombo" Width="110" IsEditable="True" AutomationProperties.AutomationId="WidthCombo"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Height" Foreground="#CCC"/>
                    <ComboBox x:Name="HeightCombo" Width="110" IsEditable="True" AutomationProperties.AutomationId="HeightCombo"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="FPS" Foreground="#CCC"/>
                    <ComboBox x:Name="FpsCombo" Width="90" IsEditable="True" AutomationProperties.AutomationId="FpsCombo"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Rotate hotkey" Foreground="#CCC" Margin="0,0,0,6"/>
            <TextBox x:Name="RotateHotkeyBox" Width="130" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.AutomationId="RotateHotkeyBox"/>

            <Separator Margin="0,4"/>

            <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Foreground="White" Margin="0,10,0,4"/>
            <CheckBox x:Name="StartMinimizedBox" Content="Start minimized to tray" Foreground="White" Margin="0,0,0,4"/>
            <CheckBox x:Name="VirtualCameraOnLaunchBox"
                      Content="Start virtual cameras at launch (one passthrough camera per hardware camera)"
                      Foreground="White" Margin="0,0,0,4"
                      AutomationProperties.AutomationId="VirtualCameraOnLaunchBox"/>
            <TextBlock Foreground="#888" Text="When on, every camera's virtual camera starts with capture — including when capture is toggled back on — so other apps can use them immediately."
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <CheckBox x:Name="PreferSmooth30FpsBox"
                      Content="Prefer smooth 30 fps (may darken the image in low light)"
                      Foreground="White" Margin="0,0,0,16"
                      AutomationProperties.AutomationId="PreferSmooth30FpsBox"/>

            <TextBlock x:Name="NoteText" Foreground="#888" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" Background="#333" Foreground="White" Click="Cancel_Click" AutomationProperties.AutomationId="CancelButton"/>
                <Button Content="Apply" Padding="14,6" Background="#2D7DD2" Foreground="White" Click="Apply_Click" AutomationProperties.AutomationId="ApplyButton"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
